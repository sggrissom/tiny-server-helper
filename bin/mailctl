#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<EOF
Usage:
  mailctl doctor
  mailctl setup <mail_hostname>
  mailctl add <domain> [selector]
  mailctl dns <domain>
  mailctl verify <domain>
  mailctl status
  mailctl test <domain> <to_address>
  mailctl rotate <domain> [selector]
  mailctl activate <domain> <selector>
  mailctl remove <domain>

Examples:
  mailctl doctor
  sudo mailctl setup mail.grissom.zone
  sudo mailctl add grissom.zone
  sudo mailctl dns grissom.zone
  sudo mailctl verify grissom.zone
  sudo mailctl status
  sudo mailctl test grissom.zone you@gmail.com
  sudo mailctl rotate grissom.zone 202702
  sudo mailctl activate grissom.zone 202702
  sudo mailctl remove releve.live
EOF
}

die() { echo "Error: $*" >&2; exit 1; }

TSH_DIR="/etc/tiny-server-helper"
MAIL_ENV="$TSH_DIR/mail.env"
DKIM_CONF="/etc/opendkim.conf"
DKIM_DIR="/etc/opendkim"
KEYS_DIR="$DKIM_DIR/keys"
KEYTABLE="$DKIM_DIR/KeyTable"
SIGNINGTABLE="$DKIM_DIR/SigningTable"
TRUSTEDHOSTS="$DKIM_DIR/TrustedHosts"
MILTER_PORT="8891"
# The same socket, spelled two different ways on purpose. Postfix's
# smtpd_milters takes inet:host:port; OpenDKIM's Socket takes inet:port@host.
# Using one form for both leaves OpenDKIM listening somewhere Postfix never
# looks, and with milter_default_action=tempfail every send then fails with
# "451 4.7.1 Service unavailable".
MILTER="inet:127.0.0.1:$MILTER_PORT"
DKIM_SOCKET="inet:$MILTER_PORT@127.0.0.1"

# ---------------------------------------------------------------------------
# check output helpers
#
# fails counts hard failures only. Things that setup has not done yet report
# as "-" (pending), not as failures, so doctor stays useful before setup runs.
# ---------------------------------------------------------------------------
fails=0
ok()   { printf "  %-34s ✅ %s\n" "$1" "${2:-}"; }
bad()  { printf "  %-34s ❌ %s\n" "$1" "${2:-}"; fails=$((fails + 1)); }
warn() { printf "  %-34s ⚠  %s\n" "$1" "${2:-}"; }
skip() { printf "  %-34s -  %s\n" "$1" "${2:-}"; }

# Unlike appctl, setup applies many privileged writes in sequence; failing
# halfway would leave Postfix partially reconfigured. Fail before touching
# anything instead.
need_root() { [[ "$(id -u)" -eq 0 ]] || die "$1 must run as root (use sudo)"; }

# Same hostname regex appctl uses for `domain`, plus a dot so we reject
# single-label names that can never be a real mail hostname.
valid_fqdn() {
  [[ "$1" == *.* ]] || return 1
  [[ "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$ ]]
}

# Follows bootstrap-vps's handling of caddy: detect, print the install line,
# do not install. Keeps the toolkit free of package managers and distro checks.
require_mail_packages() {
  local missing=()
  command -v postfix        >/dev/null 2>&1 || missing+=(postfix)
  command -v opendkim       >/dev/null 2>&1 || missing+=(opendkim)
  command -v opendkim-genkey >/dev/null 2>&1 || missing+=(opendkim-tools)
  ((${#missing[@]})) || return 0

  echo "NOTE: missing: ${missing[*]}"
  echo "Install, then re-run:"
  echo "  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y postfix opendkim opendkim-tools"
  echo ""
  echo "DEBIAN_FRONTEND=noninteractive skips postfix's debconf dialog; mailctl"
  echo "overwrites the settings it would have asked about."
  exit 1
}

# Listening addresses for a port, one per line. Empty if nothing is listening.
listener_addrs() {
  command -v ss >/dev/null 2>&1 || return 1
  ss -ltnH "( sport = :$1 )" 2>/dev/null | awk '{print $4}' | sort -u
}

is_wildcard_addr() { grep -qE '^(0\.0\.0\.0|\[?::\]?):[0-9]+$'; }

# Public IP as the internet sees it. SPF records hardcode this, so it is the
# single most important fact on the box.
public_ip() {
  local ip="" url
  for url in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
    ip="$(curl -fsS --max-time 5 "$url" 2>/dev/null | tr -d '[:space:]')" || true
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && { echo "$ip"; return 0; }
  done
  return 1
}

# Strip the trailing dot dig puts on names so comparisons work.
undot() { echo "${1%.}"; }

# Can we open a TCP connection to port 25 somewhere on the internet? Uses the
# bash /dev/tcp builtin so there is no nc/telnet dependency.
port25_open() {
  local hosts=() h
  if command -v dig >/dev/null 2>&1; then
    while IFS= read -r h; do
      [[ -n "$h" ]] && hosts+=("$(undot "$h")")
    done < <(dig +short mx gmail.com 2>/dev/null | awk '{print $2}' | head -n 2)
  fi
  # Fallback targets if dig is missing or the lookup failed.
  ((${#hosts[@]})) || hosts=(gmail-smtp-in.l.google.com aspmx.l.google.com)

  for h in "${hosts[@]}"; do
    if timeout 5 bash -c "exec 3<>/dev/tcp/$h/25" 2>/dev/null; then
      echo "$h"
      return 0
    fi
  done
  return 1
}

# Write a file atomically, then set owner and mode. mktemp lands in the target
# directory so the mv cannot cross filesystems.
install_file() {
  local dest="$1" owner="$2" mode="$3" tmp
  tmp="$(mktemp "$(dirname "$dest")/.mailctl.XXXXXX")"
  cat >"$tmp"
  chown "$owner" "$tmp"
  chmod "$mode" "$tmp"
  mv "$tmp" "$dest"
}

require_setup() {
  [[ -f "$DKIM_CONF" && -d "$KEYS_DIR" ]] \
    || die "mail is not set up yet - run: sudo mailctl setup <mail_hostname>"
}

# ---------------------------------------------------------------------------
# domain registry
#
# The filesystem is the registry, the way /srv/apps/*/ is for appctl. A domain
# is registered if it has a key directory; it is *signing* only once an
# `active` symlink points at one of its keys. Newly added domains are staged
# (key on disk, no symlink) so nothing signs before its DNS is published.
# ---------------------------------------------------------------------------
registered_domains() {
  local d
  [[ -d "$KEYS_DIR" ]] || return 0
  for d in "$KEYS_DIR"/*/; do
    [[ -d "$d" ]] || continue
    basename "$d"
  done
}

active_selector() {
  local link="$KEYS_DIR/$1/active" t
  [[ -L "$link" ]] || return 1
  t="$(basename "$(readlink "$link")")"
  echo "${t%.private}"
}

# Newest key on disk regardless of whether it is active.
newest_selector() {
  local d="$1" kf
  kf="$(ls -1t "$KEYS_DIR/$d"/*.private 2>/dev/null | head -n 1)" || return 1
  [[ -n "$kf" ]] || return 1
  kf="$(basename "$kf")"
  echo "${kf%.private}"
}

domain_state() {
  local d="$1"
  [[ -d "$KEYS_DIR/$d" ]] || { echo none; return; }
  if active_selector "$d" >/dev/null 2>&1; then echo active; else echo staged; fi
}

# Base64 public key derived from the private key, so what we publish and what
# we verify always come from the same source rather than from genkey's .txt.
pubkey_b64() {
  openssl rsa -in "$1" -pubout 2>/dev/null | grep -v -- '-----' | tr -d '\n'
}

dkim_record() { echo "v=DKIM1; h=sha256; k=rsa; s=email; p=$(pubkey_b64 "$1")"; }

# Is the DKIM record published for <domain>/<selector> the public half of
# <keyfile>? This comparison is authoritative; opendkim-testkey is advisory,
# since it does its own DNS and fails on resolver quirks that do not matter.
dkim_matches() {
  local domain="$1" sel="$2" keyfile="$3" published pub_p
  published="$(dig_txt "${sel}._domainkey.$domain" | grep -i 'v=DKIM1' || true)"
  [[ -n "$published" ]] || return 1
  pub_p="$(printf '%s' "$published" | sed -E 's/.*[;[:space:]]*p=([A-Za-z0-9+/=]*).*/\1/')"
  [[ "$pub_p" == "$(pubkey_b64 "$keyfile")" ]]
}

# Split a long TXT value into <=255-byte quoted strings for BIND zone files.
split_txt() { fold -w 200 | sed 's/^/      "/; s/$/"/'; }

# Join the quoted character-strings dig prints for a TXT record back into one
# value. Do not strip spaces - "v=DKIM1; h=sha256" needs them.
dig_txt() {
  command -v dig >/dev/null 2>&1 || return 1
  dig +short TXT "$1" 2>/dev/null | sed -e 's/" "//g' -e 's/^"//' -e 's/"$//'
}

# ---------------------------------------------------------------------------
# table regeneration
#
# KeyTable lists every key on disk (unreferenced entries are inert).
# SigningTable lists only active selectors, so staged keys never sign.
# The wildcard second line lets subdomains share the parent's key: mail from
# chess.grissom.zone gets d=grissom.zone, which passes DMARC under relaxed
# alignment (adkim=r, the default).
# ---------------------------------------------------------------------------
build_signing_lhs() { printf '*@%s\n*@*.%s\n' "$1" "$1"; }

# An optional <skip_domain> is excluded from both tables. `remove` uses it to
# commit tables that no longer reference a domain *before* deleting its keys,
# so a validation failure leaves keys and tables consistent with each other.
regenerate_tables() {
  local skip="${1:-}" tmp_kt tmp_st d sel kf out i
  tmp_kt="$(mktemp "$DKIM_DIR/.mailctl.XXXXXX")"
  tmp_st="$(mktemp "$DKIM_DIR/.mailctl.XXXXXX")"

  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    [[ "$d" == "$skip" ]] && continue
    for kf in "$KEYS_DIR/$d"/*.private; do
      [[ -f "$kf" ]] || continue
      sel="$(basename "$kf" .private)"
      echo "$sel._domainkey.$d $d:$sel:$kf" >>"$tmp_kt"
    done
    if sel="$(active_selector "$d")"; then
      while IFS= read -r lhs; do
        echo "$lhs $sel._domainkey.$d" >>"$tmp_st"
      done < <(build_signing_lhs "$d")
    fi
  done < <(registered_domains)

  # Snapshot so a bad table can be rolled back.
  cp -a "$KEYTABLE"     "$DKIM_DIR/.KeyTable.prev"     2>/dev/null || true
  cp -a "$SIGNINGTABLE" "$DKIM_DIR/.SigningTable.prev" 2>/dev/null || true

  chown root:opendkim "$tmp_kt" "$tmp_st"
  chmod 0640 "$tmp_kt" "$tmp_st"
  mv "$tmp_kt" "$KEYTABLE"
  mv "$tmp_st" "$SIGNINGTABLE"

  # Validate before the daemon ever sees them. Unlike appctl domain, which
  # commits first and validates after, a failure here rolls back.
  if ! out="$(opendkim -n -x "$DKIM_CONF" 2>&1)"; then
    restore_tables
    die "opendkim rejected the generated tables (rolled back):"$'\n'"$out"
  fi

  systemctl reload opendkim 2>/dev/null || systemctl restart opendkim

  # With milter_default_action=tempfail, an opendkim that died on reload takes
  # all outbound mail with it. Never exit 0 leaving it dead.
  for i in 1 2 3 4 5; do
    systemctl is-active --quiet opendkim && return 0
    sleep 1
  done
  restore_tables
  systemctl restart opendkim 2>/dev/null || true
  die "opendkim did not come back after reload (tables rolled back) - check: journalctl -u opendkim -n 50"
}

restore_tables() {
  [[ -f "$DKIM_DIR/.KeyTable.prev" ]]     && mv "$DKIM_DIR/.KeyTable.prev"     "$KEYTABLE"
  [[ -f "$DKIM_DIR/.SigningTable.prev" ]] && mv "$DKIM_DIR/.SigningTable.prev" "$SIGNINGTABLE"
  return 0
}

# ---------------------------------------------------------------------------
# DNS emission
# ---------------------------------------------------------------------------
# Print a value to paste. It goes flush-left between fences, alone on its
# line, so selecting it cannot pick up any surrounding prose - a DMARC record
# once went out with three lines of this tool's own guidance inside it.
paste_value() {
  echo "    +--- copy the line below, and nothing else ----------------"
  printf '%s\n' "$1"
  echo "    +----------------------------------------------------------"
}

emit_dns() {
  local domain="$1" sel="$2" keyfile="$3" ip="$4"
  local rec existing n mx receives_mail dmarc

  rec="$(dkim_record "$keyfile")"

  # Whether the domain receives mail decides two things below: whether to
  # suggest a null MX, and whether a rua= address at this domain could ever
  # collect reports. Suggesting both at once is a contradiction.
  mx="$(dig +short MX "$domain" 2>/dev/null || true)"
  receives_mail=no
  [[ -n "$mx" && "$mx" != "0 ." ]] && receives_mail=yes

  echo "=== DNS records for $domain ==="
  echo ""
  echo "Each record below gives the panel fields, then the exact value."
  echo "Copy only what is between the +--- fences. The Notes are not part"
  echo "of any record."
  echo ""

  # --- SPF: exactly one v=spf1 TXT per domain, ever ---------------------
  echo "[1] SPF"
  echo "    Type: TXT    Host: @  (or blank, for the domain itself)"
  existing="$(dig_txt "$domain" | grep -i '^v=spf1' || true)"
  n=0
  [[ -n "$existing" ]] && n="$(printf '%s\n' "$existing" | grep -c .)"
  if (( n == 0 )); then
    paste_value "v=spf1 ip4:${ip:-<server-ip>} ~all"
    echo "    Notes:"
    echo "      * Tighten ~all to -all once verify and a real test both pass."
  elif (( n == 1 )); then
    if [[ "$existing" == *"ip4:$ip"* ]]; then
      echo "    ✅ already covers ip4:$ip - no change needed"
      echo "       $existing"
    else
      echo "    ⚠  An SPF record already exists. EDIT it - do not add a second."
      echo "       Two v=spf1 records is a permerror, which is worse than none."
      echo "       Current value:"
      echo "         $existing"
      paste_value "$(printf '%s' "$existing" | sed -E "s/ (~all|-all|\\?all|\\+all)$/ ip4:${ip:-<server-ip>} \\1/")"
    fi
  else
    echo "    ❌ $n v=spf1 records found - SPF is currently permerror."
    echo "       Delete all but one before proceeding."
    printf '%s\n' "$existing" | sed 's/^/         /'
  fi
  echo ""

  # --- DKIM: emit both forms, panels and zone files disagree ------------
  echo "[2] DKIM"
  echo "    Type: TXT    Host: ${sel}._domainkey"
  paste_value "$rec"
  echo "    Notes:"
  echo "      * That is ONE line, however your terminal wraps it."
  echo "      * If your panel appends the zone name for you, enter the Host as"
  echo "        '${sel}._domainkey', not '${sel}._domainkey.$domain'."
  echo "      * Only for a BIND zone file, use this split form instead:"
  echo ""
  echo "          ${sel}._domainkey    IN    TXT    ("
  printf '%s\n' "$rec" | split_txt | sed 's/^/    /'
  echo "          )"
  echo ""

  # --- DMARC ------------------------------------------------------------
  echo "[3] DMARC"
  echo "    Type: TXT    Host: _dmarc"
  existing="$(dig_txt "_dmarc.$domain" | grep -i '^v=DMARC1' || true)"
  if [[ -n "$existing" ]]; then
    echo "    ✅ already published:"
    echo "       $existing"
  else
    # rua= is only offered when a mailbox at this domain could actually
    # receive the reports. A domain with a null MX cannot, and pointing rua
    # at a third-party address needs an authorization record on that other
    # domain, which the operator usually cannot publish.
    if [[ "$receives_mail" == yes ]]; then
      dmarc="v=DMARC1; p=none; adkim=r; aspf=r; rua=mailto:dmarc@$domain"
    else
      dmarc="v=DMARC1; p=none; adkim=r; aspf=r"
    fi
    paste_value "$dmarc"
    echo "    Notes:"
    echo "      * Start at p=none. Move to quarantine, then reject, only after"
    echo "        reports show clean passes."
    echo "      * adkim=r lets subdomains share this domain's key. Subdomains"
    echo "        inherit via sp= and need no _dmarc record of their own."
    if [[ "$receives_mail" == yes ]]; then
      echo "      * rua= points at this domain, which receives mail, so reports"
      echo "        can be delivered. Sending them to an address on a DIFFERENT"
      echo "        domain requires that domain to publish:"
      echo "          $domain._report._dmarc.<rua-domain>  TXT  v=DMARC1"
    else
      echo "      * No rua= is included: $domain accepts no mail, so reports"
      echo "        sent there could never arrive. To collect them, use a DMARC"
      echo "        reporting service - it supplies an address on its own domain"
      echo "        and publishes the authorization record for you."
    fi
  fi
  echo ""

  # --- null MX, only when the domain receives no mail -------------------
  echo "[4] MX"
  if [[ -z "$mx" ]]; then
    echo "    Type: MX    Host: @    Priority: 0    Value: ."
    echo "    Notes:"
    echo "      * Priority must be exactly 0 and the value exactly a single dot."
    echo "        Anything else is not a null MX."
    echo "      * This is RFC 7505: 'this domain accepts no mail'. It PERMANENTLY"
    echo "        disables inbound mail for $domain until you remove it."
    echo "      * Why bother: with no MX, receivers fall back to your A record,"
    echo "        which points at this server - but port 25 is loopback-only, so"
    echo "        bounces and sender callouts hang instead of failing fast."
    echo "      * Optional. It does not affect whether your mail is delivered."
  elif [[ "$mx" == "0 ." ]]; then
    echo "    ✅ null MX published - domain correctly declares it accepts no mail"
  else
    echo "    ✅ receives mail elsewhere - leave MX alone"
    printf '%s\n' "$mx" | sed 's/^/         /'
  fi
}

# ---------------------------------------------------------------------------

cmd="${1:-}"
[[ -n "${cmd}" ]] || { usage; exit 1; }

case "$cmd" in
  doctor)
    echo "== mailctl doctor =="
    echo ""
    echo "Infrastructure (cannot be fixed by mailctl):"

    # --- outbound port 25 -------------------------------------------------
    # The gate. Most VPS providers block this by default; GCP blocks it
    # permanently with no exception. Everything else is moot if this fails.
    if reached="$(port25_open)"; then
      ok "Outbound TCP :25" "reachable ($reached)"
      port25=yes
    else
      bad "Outbound TCP :25" "BLOCKED"
      port25=no
    fi

    # --- public IP --------------------------------------------------------
    if ip="$(public_ip)"; then
      if ip -4 addr show 2>/dev/null | grep -qF " $ip/"; then
        ok "Public IP" "$ip (bound locally)"
      else
        # Common and fine on VPSes that NAT, but SPF still needs the public one.
        ok "Public IP" "$ip (not bound locally - NAT?)"
      fi
    else
      ip=""
      bad "Public IP" "could not determine"
    fi

    # --- PTR / forward-confirmed reverse DNS ------------------------------
    if [[ -z "$ip" ]]; then
      skip "Reverse DNS (PTR)" "no public IP"
      skip "Forward-confirmed (FCrDNS)" ""
    elif ! command -v dig >/dev/null 2>&1; then
      skip "Reverse DNS (PTR)" "dig not installed"
      skip "Forward-confirmed (FCrDNS)" ""
    else
      ptr="$(undot "$(dig +short -x "$ip" 2>/dev/null | head -n 1)")"
      if [[ -z "$ptr" ]]; then
        bad "Reverse DNS (PTR)" "not set - set it at your VPS provider"
        skip "Forward-confirmed (FCrDNS)" "no PTR"
      else
        ok "Reverse DNS (PTR)" "$ptr"
        fwd="$(dig +short A "$ptr" 2>/dev/null | head -n 1)"
        if [[ "$fwd" == "$ip" ]]; then
          ok "Forward-confirmed (FCrDNS)" "$ptr -> $ip"
        else
          bad "Forward-confirmed (FCrDNS)" "$ptr -> ${fwd:-<none>}, expected $ip"
        fi
      fi
    fi

    echo ""
    echo "Mail services:"

    # --- packages ---------------------------------------------------------
    have_postfix=no
    have_opendkim=no
    command -v postfix  >/dev/null 2>&1 && have_postfix=yes
    command -v opendkim >/dev/null 2>&1 && have_opendkim=yes

    if [[ "$have_postfix" == yes && "$have_opendkim" == yes ]]; then
      ok "Packages" "postfix + opendkim installed"
    else
      missing=""
      [[ "$have_postfix"  == no ]] && missing="postfix"
      [[ "$have_opendkim" == no ]] && missing="${missing:+$missing }opendkim"
      skip "Packages" "not installed: $missing"
    fi

    # --- service state ----------------------------------------------------
    for svc in postfix opendkim; do
      var="have_$svc"
      if [[ "${!var}" == no ]]; then
        skip "$svc" "not installed"
        continue
      fi
      state="stopped"
      systemctl is-active --quiet "$svc" 2>/dev/null && state="active"
      enabled="disabled"
      systemctl is-enabled --quiet "$svc" 2>/dev/null && enabled="enabled"
      if [[ "$state" == active && "$enabled" == enabled ]]; then
        ok "$svc" "active (enabled)"
      elif [[ "$state" == active ]]; then
        bad "$svc" "active but NOT enabled - will not survive reboot"
      else
        bad "$svc" "$state ($enabled)"
      fi
    done

    echo ""
    echo "Not an open relay:"

    # --- :25 must be loopback-only ---------------------------------------
    if [[ "$have_postfix" == no ]]; then
      skip "Listener :25" "postfix not installed"
    elif ! command -v ss >/dev/null 2>&1; then
      skip "Listener :25" "ss not installed"
    else
      listeners="$(listener_addrs 25 || true)"
      if [[ -z "$listeners" ]]; then
        bad "Listener :25" "nothing listening"
      elif echo "$listeners" | is_wildcard_addr; then
        bad "Listener :25" "OPEN TO THE INTERNET ($(echo "$listeners" | tr '\n' ' '))"
      else
        ok "Listener :25" "$(echo "$listeners" | tr '\n' ' ')"
      fi
    fi

    # --- opendkim milter socket ------------------------------------------
    if [[ "$have_opendkim" == no ]]; then
      skip "Listener :$MILTER_PORT" "opendkim not installed"
    elif ! command -v ss >/dev/null 2>&1; then
      skip "Listener :$MILTER_PORT" "ss not installed"
    else
      dkl="$(listener_addrs "$MILTER_PORT" || true)"
      if [[ -z "$dkl" ]]; then
        skip "Listener :$MILTER_PORT" "not listening (setup not run?)"
      elif echo "$dkl" | is_wildcard_addr; then
        bad "Listener :$MILTER_PORT" "bound to all interfaces ($(echo "$dkl" | tr '\n' ' '))"
      else
        ok "Listener :$MILTER_PORT" "$(echo "$dkl" | tr '\n' ' ')"
      fi
    fi

    # --- submission / smtps must never be enabled -------------------------
    if [[ "$have_postfix" == no ]]; then
      skip "submission/smtps" "postfix not installed"
    else
      if enabled_svc="$(postconf -M 2>/dev/null | grep -E '^(submission|smtps)/inet' || true)" \
         && [[ -n "$enabled_svc" ]]; then
        bad "submission/smtps" "ENABLED - public submission ports must stay off"
      else
        ok "submission/smtps" "not enabled"
      fi
    fi

    echo ""
    echo "Deliverability:"

    # --- root alias must leave the box ------------------------------------
    # Without this, every bounce and Postfix error notice rots in
    # /var/mail/root on a box nobody reads mail on.
    if [[ ! -f /etc/aliases ]]; then
      skip "root alias" "/etc/aliases not present"
    else
      root_target="$(grep -E '^root:' /etc/aliases 2>/dev/null | head -n 1 | cut -d: -f2- | tr -d '[:space:]' || true)"
      if [[ -z "$root_target" ]]; then
        bad "root alias" "not set - bounces will be lost"
      elif [[ "$root_target" != *@* ]]; then
        bad "root alias" "'$root_target' is local - use an external mailbox"
      else
        ok "root alias" "$root_target"
      fi
    fi

    # --- queue depth ------------------------------------------------------
    # A growing deferred queue is the earliest symptom of every mail problem.
    if [[ "$have_postfix" == no ]]; then
      skip "Mail queue" "postfix not installed"
    else
      qcount="$(postqueue -p 2>/dev/null | grep -cE '^[0-9A-F]{6,}[*!]?' || true)"
      qcount="${qcount:-0}"
      if (( qcount == 0 )); then
        ok "Mail queue" "empty"
      elif (( qcount < 10 )); then
        warn "Mail queue" "$qcount message(s) queued"
      else
        bad "Mail queue" "$qcount messages queued - check: postqueue -p"
      fi
    fi

    echo ""
    if (( fails > 0 )); then
      echo "❌ $fails check(s) failed."
      if [[ "$port25" == no ]]; then
        echo ""
        echo "Outbound port 25 is blocked. This is the one blocker mailctl cannot"
        echo "work around. Most VPS providers block it by default and will open it"
        echo "on request; Google Cloud blocks it permanently with no exception."
        echo ""
        echo "Next steps:"
        echo "  1. Open a support ticket asking to unblock outbound TCP 25"
        echo "  2. If they refuse, your only options are a relay host or a"
        echo "     different provider - self-hosted delivery is not possible here"
      fi
      exit 1
    fi

    echo "✅ All checks passed."
    ;;

  setup)
    need_root setup
    host="${2:-}"
    [[ -n "$host" ]] || die "missing <mail_hostname>"
    valid_fqdn "$host" || die "invalid mail hostname: $host"

    require_mail_packages
    getent passwd opendkim >/dev/null 2>&1 || die "opendkim user missing - reinstall the opendkim package"

    echo "== mailctl setup =="
    echo "  Mail hostname: $host"
    echo ""

    # --- DNS sanity, advisory only ---------------------------------------
    # These are set elsewhere and may legitimately lag behind setup.
    if ip="$(public_ip)" && command -v dig >/dev/null 2>&1; then
      a_rec="$(dig +short A "$host" 2>/dev/null | head -n 1)"
      [[ "$a_rec" == "$ip" ]] \
        && ok "A record" "$host -> $ip" \
        || warn "A record" "$host -> ${a_rec:-<none>}, expected $ip"

      ptr="$(undot "$(dig +short -x "$ip" 2>/dev/null | head -n 1)")"
      [[ "$ptr" == "$host" ]] \
        && ok "Reverse DNS (PTR)" "$ip -> $host" \
        || warn "Reverse DNS (PTR)" "$ip -> ${ptr:-<none>}, expected $host"
      echo ""
    fi

    # --- Postfix ----------------------------------------------------------
    # postconf -e is idempotent by construction: it rewrites the line if
    # present and appends it if not, so re-running setup is a no-op.
    #
    # Note smtpd_tls_security_level = none below. Debian ships `may` with a
    # snakeoil cert, so Postfix would advertise STARTTLS on loopback and any
    # client that auto-upgrades (Go's net/smtp does) fails certificate
    # validation against 127.0.0.1. Nothing external can reach this listener,
    # so TLS on it buys nothing and costs every app a confusing error.
    echo "Configuring Postfix..."
    postconf -e \
      "myhostname = $host" \
      'myorigin = $myhostname' \
      'smtp_helo_name = $myhostname' \
      'smtpd_banner = $myhostname ESMTP' \
      'mydestination = $myhostname, localhost.$mydomain, localhost' \
      "relayhost =" \
      "inet_interfaces = loopback-only" \
      "inet_protocols = ipv4" \
      "mynetworks = 127.0.0.0/8 [::1]/128" \
      "mynetworks_style = host" \
      "smtpd_relay_restrictions = permit_mynetworks, reject" \
      "smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination" \
      "smtpd_client_restrictions = permit_mynetworks, reject" \
      "smtpd_helo_required = yes" \
      "disable_vrfy_command = yes" \
      "smtpd_tls_security_level = none" \
      "smtp_tls_security_level = may" \
      "smtp_tls_note_starttls_offer = yes" \
      "smtp_tls_loglevel = 1" \
      "smtp_tls_CApath = /etc/ssl/certs" \
      "milter_protocol = 6" \
      "milter_default_action = tempfail" \
      "smtpd_milters = $MILTER" \
      "non_smtpd_milters = $MILTER" \
      "maximal_queue_lifetime = 3d" \
      "bounce_queue_lifetime = 1d" \
      "notify_classes = resource, software, bounce, 2bounce" \
      "message_size_limit = 20480000"

    echo "$host" | install_file /etc/mailname root:root 0644

    # postmaster must resolve somewhere. The root: target is the human's call,
    # so we only guarantee the postmaster -> root hop.
    if [[ -f /etc/aliases ]] && ! grep -qE '^postmaster:' /etc/aliases; then
      echo "postmaster: root" >>/etc/aliases
    fi
    [[ -f /etc/aliases ]] && newaliases 2>/dev/null || true

    # --- OpenDKIM ---------------------------------------------------------
    echo "Configuring OpenDKIM..."
    mkdir -p "$DKIM_DIR" "$KEYS_DIR"
    chown root:opendkim "$DKIM_DIR"
    chmod 0750 "$DKIM_DIR"
    chown opendkim:opendkim "$KEYS_DIR"
    chmod 0700 "$KEYS_DIR"

    install_file "$DKIM_CONF" root:root 0644 <<EOF
# Managed by mailctl. Regenerated by 'mailctl setup'.
Syslog                  yes
SyslogSuccess           yes
LogWhy                  no

UserID                  opendkim
UMask                   007
PidFile                 /run/opendkim/opendkim.pid

# Sign only. The verification code path never runs, so this daemon never
# parses untrusted input - it only sees mail our own apps submitted locally.
Mode                    s

# A loopback TCP socket avoids the whole chroot/permissions class of bugs that
# comes with a unix socket under /var/spool/postfix. It grants no capability
# that 127.0.0.1:25 does not already grant to the same local users.
Socket                  $DKIM_SOCKET

Canonicalization        relaxed/simple
SignatureAlgorithm      rsa-sha256
MinimumKeyBits          1024

# Sign From once more than it appears, so a replayed message cannot keep a
# valid signature by prepending a second From header.
OversignHeaders         From

KeyTable                refile:$KEYTABLE
SigningTable            refile:$SIGNINGTABLE
InternalHosts           refile:$TRUSTEDHOSTS
ExternalIgnoreList      refile:$TRUSTEDHOSTS
EOF

    # InternalHosts is the list OpenDKIM *signs* for. Without 127.0.0.1 here,
    # nothing is ever signed while everything else looks healthy.
    install_file "$TRUSTEDHOSTS" root:opendkim 0640 <<EOF
127.0.0.1
::1
localhost
$host
EOF

    # Never clobber existing tables - they are derived from the keys on disk.
    for t in "$KEYTABLE" "$SIGNINGTABLE"; do
      if [[ ! -f "$t" ]]; then
        : | install_file "$t" root:opendkim 0640
      fi
    done

    # Debian generates a systemd override from SOCKET= in /etc/default/opendkim
    # which can silently contradict opendkim.conf. Keep the two in agreement.
    if [[ -f /etc/default/opendkim ]]; then
      if grep -qE '^\s*#?\s*SOCKET=' /etc/default/opendkim; then
        sed -i "s|^\s*#\?\s*SOCKET=.*|SOCKET=\"$DKIM_SOCKET\"|" /etc/default/opendkim
      else
        echo "SOCKET=\"$DKIM_SOCKET\"" >>/etc/default/opendkim
      fi
      [[ -x /lib/opendkim/opendkim.service.generate ]] && /lib/opendkim/opendkim.service.generate || true
    fi

    # --- env injection for apps -------------------------------------------
    # A drop-in rather than an edit to systemd/app@.service keeps the unit
    # templates in git mail-agnostic and makes uninstall an rm.
    echo "Wiring SMTP env into app units..."
    mkdir -p "$TSH_DIR"
    install_file "$MAIL_ENV" root:root 0644 <<EOF
# Managed by mailctl. Read by app@ and internal@ units via a systemd drop-in.
# Nothing here is secret - loopback submission is the whole design.
# Per-app MAIL_FROM belongs in /srv/apps/<app>/shared/.env, not here.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
MAIL_HOSTNAME=$host
EOF

    for unit in app internal; do
      mkdir -p "/etc/systemd/system/${unit}@.service.d"
      install_file "/etc/systemd/system/${unit}@.service.d/10-mail.conf" root:root 0644 <<EOF
# Managed by mailctl. Gives every $unit@ service SMTP_HOST/SMTP_PORT with no
# per-app config and no redeploy - EnvironmentFile is read at each ExecStart.
#
# Do not add PrivateNetwork=yes, IPAddressDeny=, or a restrictive
# RestrictAddressFamilies= to these units: loopback SMTP breaks and the
# failure looks like a Postfix problem, not a systemd one.
[Service]
EnvironmentFile=-$MAIL_ENV
EOF
    done
    systemctl daemon-reload

    # --- start ------------------------------------------------------------
    # These are infrastructure, not app units, so mailctl enables them rather
    # than printing an enable line the way appctl init does.
    echo "Starting services..."
    systemctl enable opendkim >/dev/null 2>&1 || true
    systemctl enable postfix  >/dev/null 2>&1 || true
    systemctl restart opendkim
    # inet_interfaces only takes effect on a full restart, never on reload.
    systemctl restart postfix

    echo ""
    echo "Verifying..."
    dkl="$(listener_addrs "$MILTER_PORT" || true)"
    [[ -n "$dkl" ]] || die "opendkim is not listening on $MILTER_PORT - check: journalctl -u opendkim -n 50"
    ok "Listener :$MILTER_PORT" "$(echo "$dkl" | tr '\n' ' ')"

    l25="$(listener_addrs 25 || true)"
    [[ -n "$l25" ]] || die "postfix is not listening on 25 - check: journalctl -u postfix -n 50"
    if echo "$l25" | is_wildcard_addr; then
      die "postfix is listening on all interfaces - inet_interfaces did not apply"
    fi
    ok "Listener :25" "$(echo "$l25" | tr '\n' ' ')"

    echo ""
    echo "✅ Setup complete."
    echo ""
    echo "Next steps:"
    echo "  1. Point /etc/aliases root: at a mailbox you actually read, then"
    echo "     run newaliases. Without it, bounces and Postfix error notices"
    echo "     are lost:"
    echo "       root: you@example.com"
    echo "  2. Publish DNS for the mail hostname itself:"
    echo "       $host.  IN A    ${ip:-<server-ip>}"
    echo "       $host.  IN TXT  \"v=spf1 a -all\""
    echo "  3. Set reverse DNS for ${ip:-<server-ip>} to $host at your VPS provider"
    echo "  4. Register a sending domain:  sudo mailctl add example.com"
    echo "  5. Restart apps to pick up SMTP_HOST/SMTP_PORT (no redeploy needed):"
    echo "       sudo systemctl restart app@<name>"
    ;;

  add)
    need_root add
    require_mail_packages
    require_setup
    domain="${2:-}"
    selector="${3:-$(date +%Y%m)}"
    [[ -n "$domain" ]] || die "missing <domain>"
    valid_fqdn "$domain" || die "invalid domain: $domain"
    [[ "$selector" =~ ^[a-zA-Z0-9_-]+$ ]] || die "invalid selector: $selector"

    ip="$(public_ip || true)"
    dir="$KEYS_DIR/$domain"
    state="$(domain_state "$domain")"

    if [[ "$state" != none ]]; then
      # Create-once, like appctl init's shared/.env. Never silently replace a
      # key - that would invalidate DNS that is already published.
      sel="$(active_selector "$domain" 2>/dev/null || newest_selector "$domain")"
      echo "$domain is already registered (selector $sel, state: $state)."
      echo "Keeping the existing key. To roll to a new one: sudo mailctl rotate $domain"
      echo ""
      emit_dns "$domain" "$sel" "$dir/$sel.private" "$ip"
      exit 0
    fi

    echo "Generating 2048-bit DKIM key for $domain (selector $selector)..."
    mkdir -p "$dir"
    opendkim-genkey -b 2048 -r -h sha256 -d "$domain" -s "$selector" -D "$dir"
    chown -R opendkim:opendkim "$dir"
    chmod 0700 "$dir"
    chmod 0600 "$dir/$selector.private"
    chmod 0644 "$dir/$selector.txt"

    # Staged, not signing: the key is in KeyTable but has no `active` symlink,
    # so SigningTable has no entry for it. Nothing is signed until the DNS is
    # published and `mailctl verify` confirms it.
    regenerate_tables

    echo ""
    emit_dns "$domain" "$selector" "$dir/$selector.private" "$ip"
    echo ""
    echo "Status: STAGED - $domain is not signing yet."
    echo ""
    echo "Next steps:"
    echo "  1. Publish the records above at your DNS provider"
    echo "  2. Wait for propagation (usually a few minutes)"
    echo "  3. sudo mailctl verify $domain    # activates signing once DKIM checks out"
    ;;

  dns)
    # Reading the key to derive the public half needs root: key dirs are 0700.
    need_root dns
    require_setup
    domain="${2:-}"
    [[ -n "$domain" ]] || die "missing <domain>"
    [[ "$(domain_state "$domain")" != none ]] || die "$domain is not registered - run: sudo mailctl add $domain"
    sel="$(active_selector "$domain" 2>/dev/null || newest_selector "$domain")"
    emit_dns "$domain" "$sel" "$KEYS_DIR/$domain/$sel.private" "$(public_ip || true)"
    ;;

  remove)
    need_root remove
    require_setup
    domain="${2:-}"
    [[ -n "$domain" ]] || die "missing <domain>"
    [[ "$(domain_state "$domain")" != none ]] || die "$domain is not registered"

    sel="$(active_selector "$domain" 2>/dev/null || newest_selector "$domain")"
    echo "Removing $domain (selector $sel)..."
    # Commit tables without the domain first. If that fails it rolls back and
    # dies with the keys still in place, rather than orphaning them.
    regenerate_tables "$domain"
    rm -rf "${KEYS_DIR:?}/${domain:?}"

    echo "✅ Removed. $domain no longer has a key or a signing rule."
    echo ""
    echo "Note: mail with a From address at $domain will now go out UNSIGNED"
    echo "rather than being rejected - a missing signing rule is a silent"
    echo "pass-through, unlike a dead milter."
    echo ""
    echo "Next steps - delete these DNS records:"
    echo "  ${sel}._domainkey.$domain   TXT"
    echo "  _dmarc.$domain              TXT   (only if nothing else sends for it)"
    echo "Review SPF for $domain: remove ip4:$(public_ip || echo '<server-ip>')"
    echo "only if no other service on this box sends as $domain."
    ;;

  verify)
    need_root verify
    require_setup
    command -v dig >/dev/null 2>&1 || die "dig is required (apt-get install -y dnsutils)"
    domain="${2:-}"
    [[ -n "$domain" ]] || die "missing <domain>"
    state="$(domain_state "$domain")"
    [[ "$state" != none ]] || die "$domain is not registered - run: sudo mailctl add $domain"

    sel="$(active_selector "$domain" 2>/dev/null || newest_selector "$domain")"
    keyfile="$KEYS_DIR/$domain/$sel.private"
    ip="$(public_ip || true)"

    echo "== verify $domain (selector $sel, state: $state) =="
    echo ""

    # --- DKIM: the published key must match the private key we sign with ---
    dkim_ok=no
    if dkim_matches "$domain" "$sel" "$keyfile"; then
      ok "DKIM (${sel}._domainkey)" "published, matches local key"
      dkim_ok=yes
    elif [[ -z "$(dig_txt "${sel}._domainkey.$domain" | grep -i 'v=DKIM1' || true)" ]]; then
      bad "DKIM (${sel}._domainkey)" "not published"
    else
      bad "DKIM (${sel}._domainkey)" "published key does NOT match the private key"
    fi
    # Secondary signal; the comparison above is authoritative.
    if [[ "$dkim_ok" == yes ]] && command -v opendkim-testkey >/dev/null 2>&1; then
      if opendkim-testkey -d "$domain" -s "$sel" -k "$keyfile" >/dev/null 2>&1; then
        ok "opendkim-testkey" "passed"
      else
        warn "opendkim-testkey" "reported a problem (often DNSSEC/resolver related)"
      fi
    fi

    # --- SPF ---------------------------------------------------------------
    spf="$(dig_txt "$domain" | grep -i '^v=spf1' || true)"
    spf_n=0
    [[ -n "$spf" ]] && spf_n="$(printf '%s\n' "$spf" | grep -c .)"
    if (( spf_n == 0 )); then
      bad "SPF" "no v=spf1 record"
    elif (( spf_n > 1 )); then
      bad "SPF" "$spf_n records - permerror, delete all but one"
    elif [[ -n "$ip" && "$spf" == *"ip4:$ip"* ]]; then
      ok "SPF" "covers ip4:$ip"
    else
      bad "SPF" "does not list ip4:${ip:-<server-ip>} - $spf"
    fi

    # --- DMARC -------------------------------------------------------------
    dmarc="$(dig_txt "_dmarc.$domain" | grep -i '^v=DMARC1' || true)"
    if [[ -z "$dmarc" ]]; then
      bad "DMARC" "no _dmarc record"
    else
      policy="$(printf '%s' "$dmarc" | sed -E 's/.*p=([a-z]+).*/\1/')"
      ok "DMARC" "p=$policy"
    fi

    # --- MX: informational only -------------------------------------------
    mx="$(dig +short MX "$domain" 2>/dev/null || true)"
    if [[ -z "$mx" ]]; then
      warn "MX" "none - consider a null MX (see: sudo mailctl dns $domain)"
    elif [[ "$mx" == "0 ." ]]; then
      ok "MX" "null MX (accepts no mail)"
    else
      ok "MX" "$(printf '%s' "$mx" | tr '\n' ' ')"
    fi

    echo ""
    # --- activate a staged domain once its DKIM is provably live ----------
    if [[ "$dkim_ok" == yes && "$state" == staged ]]; then
      echo "DKIM is live. Activating signing for $domain..."
      ln -sfn "$sel.private" "$KEYS_DIR/$domain/active"
      chown -h opendkim:opendkim "$KEYS_DIR/$domain/active"
      regenerate_tables
      echo "✅ $domain is now signing with selector $sel."
    elif [[ "$dkim_ok" == no && "$state" == staged ]]; then
      echo "$domain stays STAGED (not signing) until its DKIM record is live."
    fi

    if (( fails > 0 )); then
      echo ""
      echo "❌ $fails check(s) failed."
      exit 1
    fi
    echo ""
    echo "✅ $domain checks out."
    ;;

  status)
    need_root status
    require_setup
    any=no
    while IFS= read -r d; do
      [[ -n "$d" ]] || continue
      any=yes
      st="$(domain_state "$d")"
      s="$(active_selector "$d" 2>/dev/null || newest_selector "$d" || echo '-')"
      dns_state="unknown"
      if command -v dig >/dev/null 2>&1; then
        if dig_txt "${s}._domainkey.$d" | grep -qi 'v=DKIM1'; then
          dns_state="published"
        else
          dns_state="MISSING"
        fi
      fi
      printf "%-28s %-8s %-10s %s\n" "$d" "$st" "$s" "$dns_state"
    done < <(registered_domains)
    [[ "$any" == yes ]] || echo "(no domains registered - sudo mailctl add <domain>)"

    echo ""
    p_state="stopped"; systemctl is-active --quiet postfix  2>/dev/null && p_state="active"
    o_state="stopped"; systemctl is-active --quiet opendkim 2>/dev/null && o_state="active"
    qcount="$(postqueue -p 2>/dev/null | grep -cE '^[0-9A-F]{6,}[*!]?' || true)"
    echo "postfix: $p_state   opendkim: $o_state   queue: ${qcount:-0}"
    ;;

  test)
    need_root test
    require_setup
    domain="${2:-}"
    to="${3:-}"
    [[ -n "$domain" ]] || die "missing <domain>"
    [[ -n "$to" ]] || die "missing <to_address>"
    [[ "$to" == *@* ]] || die "invalid recipient: $to"
    [[ "$(domain_state "$domain")" == active ]] \
      || die "$domain is not signing yet (state: $(domain_state "$domain")) - run: sudo mailctl verify $domain"
    command -v sendmail >/dev/null 2>&1 || die "sendmail not found - is postfix installed?"

    from="noreply@$domain"
    stamp="$(date +%Y%m%d-%H%M%S)"
    echo "Sending test message: $from -> $to"

    # Submitted via sendmail (the pickup path), which only gets signed because
    # main.cf sets non_smtpd_milters as well as smtpd_milters.
    sendmail -f "$from" "$to" <<EOF
From: tiny-server-helper <$from>
To: $to
Subject: mailctl test $stamp
Date: $(date -R)
Message-ID: <mailctl-$stamp@$domain>

This is a test message from mailctl on $(hostname -f 2>/dev/null || hostname).

Domain:   $domain
Selector: $(active_selector "$domain")
Sent:     $(date -R)
EOF

    echo "✅ Queued."
    echo ""
    echo "Next steps:"
    echo "  1. Check the received message's headers for all three:"
    echo "       Authentication-Results: ... dkim=pass header.d=$domain"
    echo "       Authentication-Results: ... spf=pass"
    echo "       Authentication-Results: ... dmarc=pass"
    echo "  2. Confirm it was signed locally:"
    echo "       journalctl -u opendkim -n 20 | grep 'DKIM-Signature field added'"
    echo "  3. Confirm it was delivered:"
    echo "       journalctl -u postfix -n 30 | grep 'status=sent'"
    echo "  4. Anything stuck?  postqueue -p"
    echo ""
    echo "For a full third-party report, forward the message to:"
    echo "  check-auth@verifier.port25.com"
    ;;

  rotate)
    # Phase 1 of 2. Generates a new key alongside the old one and adds it to
    # KeyTable, but leaves `active` alone - so signing does not change and no
    # in-flight mail breaks. `activate` is phase 2.
    need_root rotate
    require_mail_packages
    require_setup
    domain="${2:-}"
    selector="${3:-$(date +%Y%m)}"
    [[ -n "$domain" ]] || die "missing <domain>"
    [[ "$(domain_state "$domain")" != none ]] || die "$domain is not registered"
    [[ "$selector" =~ ^[a-zA-Z0-9_-]+$ ]] || die "invalid selector: $selector"

    dir="$KEYS_DIR/$domain"
    cur="$(active_selector "$domain" 2>/dev/null || newest_selector "$domain")"
    [[ "$selector" != "$cur" ]] || die "selector $selector is already in use - pass a different one, e.g. sudo mailctl rotate $domain $(date +%Y%m)b"
    [[ ! -f "$dir/$selector.private" ]] || die "a key for selector $selector already exists"

    echo "Generating replacement key for $domain (selector $selector, current: $cur)..."
    opendkim-genkey -b 2048 -r -h sha256 -d "$domain" -s "$selector" -D "$dir"
    chown opendkim:opendkim "$dir/$selector.private" "$dir/$selector.txt"
    chmod 0600 "$dir/$selector.private"
    chmod 0644 "$dir/$selector.txt"
    regenerate_tables

    echo ""
    echo "=== New DKIM record for $domain ==="
    echo ""
    echo "[1] DKIM"
    echo "    Type: TXT    Host: ${selector}._domainkey"
    paste_value "$(dkim_record "$dir/$selector.private")"
    echo "    Notes:"
    echo "      * That is ONE line, however your terminal wraps it."
    echo "      * Leave the existing ${cur}._domainkey record in place."
    echo ""
    echo "Signing is UNCHANGED - $domain still signs with $cur."
    echo ""
    echo "Next steps:"
    echo "  1. Publish the record above (leave the $cur record in place)"
    echo "  2. sudo mailctl activate $domain $selector"
    ;;

  activate)
    # Phase 2 of 2. Refuses unless the new key is provably live in DNS, so a
    # rotation can never switch signing to a key nobody can verify.
    need_root activate
    require_setup
    command -v dig >/dev/null 2>&1 || die "dig is required (apt-get install -y dnsutils)"
    domain="${2:-}"
    selector="${3:-}"
    [[ -n "$domain" ]] || die "missing <domain>"
    [[ -n "$selector" ]] || die "missing <selector>"
    [[ "$(domain_state "$domain")" != none ]] || die "$domain is not registered"

    dir="$KEYS_DIR/$domain"
    [[ -f "$dir/$selector.private" ]] || die "no key for selector $selector - run: sudo mailctl rotate $domain $selector"
    prev="$(active_selector "$domain" 2>/dev/null || echo '')"

    echo "Checking that ${selector}._domainkey.$domain is live..."
    dkim_matches "$domain" "$selector" "$dir/$selector.private" \
      || die "the published record for $selector does not match its private key (or is not published yet) - publish it and retry"
    ok "DKIM (${selector}._domainkey)" "published, matches local key"

    ln -sfn "$selector.private" "$dir/active"
    chown -h opendkim:opendkim "$dir/active"
    regenerate_tables

    echo ""
    echo "✅ $domain now signs with selector $selector."
    if [[ -n "$prev" && "$prev" != "$selector" ]]; then
      echo ""
      echo "Next steps:"
      echo "  1. Leave ${prev}._domainkey.$domain published for ~7 days so mail"
      echo "     already in flight can still be verified"
      echo "  2. Then delete that DNS record and the old key:"
      echo "       sudo rm $dir/${prev}.private $dir/${prev}.txt"
    fi
    ;;

  *)
    usage
    exit 1
    ;;
esac
